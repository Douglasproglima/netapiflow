<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>NetApiFlow.EntityFrameworkCore</PackageId>
    <Description>Records Entity Framework Core database commands as NetApiFlow steps through a DbCommandInterceptor.</Description>
    <PackageTags>$(PackageTags);efcore;entity-framework-core;sql</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NetApiFlow\NetApiFlow.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\docs\images\icon.png" Pack="true" PackagePath="\" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
