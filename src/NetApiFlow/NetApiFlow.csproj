<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>NetApiFlow</PackageId>
    <Description>Shows, in real time, the path each HTTP request takes through an ASP.NET Core API: controller or endpoint, services, repositories and SQL, with the duration of each step.</Description>
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\docs\images\icon.png" Pack="true" PackagePath="\" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
