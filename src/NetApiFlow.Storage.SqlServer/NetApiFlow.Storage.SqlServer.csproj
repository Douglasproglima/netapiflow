<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>NetApiFlow.Storage.SqlServer</PackageId>
    <Description>Stores NetApiFlow traces in SQL Server instead of memory and creates the schema automatically.</Description>
    <PackageTags>$(PackageTags);sqlserver;storage</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NetApiFlow\NetApiFlow.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\docs\images\icon.png" Pack="true" PackagePath="\" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
