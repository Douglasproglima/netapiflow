<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>NetApiFlow.Testing</PackageId>
    <Description>Assertions over the flow a request actually took, for integration tests, such as how many database calls an endpoint makes.</Description>
    <PackageTags>$(PackageTags);testing;integration-testing</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NetApiFlow\NetApiFlow.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\docs\images\icon.png" Pack="true" PackagePath="\" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
