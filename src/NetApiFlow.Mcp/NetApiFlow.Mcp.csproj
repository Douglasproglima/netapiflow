<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>NetApiFlow.Mcp</PackageId>
    <Description>A read-only MCP server that lets an AI agent query NetApiFlow traces through standard MCP tools.</Description>
    <PackageTags>$(PackageTags);mcp;ai</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NetApiFlow\NetApiFlow.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\docs\images\icon.png" Pack="true" PackagePath="\" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
