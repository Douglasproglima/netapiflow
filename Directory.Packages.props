<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- Testing -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="Testcontainers" Version="4.16.0" />
  </ItemGroup>

  <!-- Microsoft.AspNetCore.Mvc.Testing ships one version per ASP.NET Core major release. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.33" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.0" />
  </ItemGroup>

  <!-- Build-time only (netstandard2.0 MSBuild tooling): one version works for every TargetFramework consuming it. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <PackageVersion Include="Testcontainers.MsSql" Version="4.16.0" />

    <!-- NetApiFlow.EntityFrameworkCore -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="9.0.22" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="9.0.22" />

    <!-- Test-only: exercises FlowDbCommandInterceptor against a real relational provider (InMemory never calls DbCommandInterceptor) -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.22" />

    <!-- samples/SampleApi.Controllers -->
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.4" />

    <!-- samples/* (Runner tab of the dashboard reads each sample's own OpenAPI document) -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="9.0.21" />

    <!-- NetApiFlow.MediatR -->
    <PackageVersion Include="MediatR" Version="14.2.0" />

    <!-- NetApiFlow.Storage.PostgreSql -->
    <PackageVersion Include="Npgsql" Version="10.0.3" />

    <!-- NetApiFlow.Storage.SqlServer -->
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="7.1.1" />

    <!-- SourceLink (every src/ package) -->
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.403" />

    <!-- tests/NetApiFlow.Benchmarks (Fase 7, medição de overhead) -->
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.0" />
  </ItemGroup>

</Project>
