<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- Testing -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="coverlet.collector" Version="10.1.1" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="Testcontainers" Version="4.16.0" />
  </ItemGroup>

  <!-- Microsoft.AspNetCore.Mvc.Testing ships one version per ASP.NET Core major release. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.34" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.0" />
  </ItemGroup>

  <!-- Runtime dependency of NetApiFlow.Dashboard (ManifestEmbeddedFileProvider serves the embedded
       Angular dist/), so it follows the consumer's TargetFramework like the one above. A single
       10.0.0 made the net8.0 assembly bind against 10.0.0.0, which no ASP.NET Core 8 shared
       framework can satisfy on its own. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageVersion Include="Microsoft.Extensions.FileProviders.Embedded" Version="8.0.34" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageVersion Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.17.0" />
    <PackageVersion Include="Testcontainers.MsSql" Version="4.17.0" />

    <!-- NetApiFlow.EntityFrameworkCore -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="9.0.23" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="9.0.23" />

    <!-- Test-only: exercises FlowDbCommandInterceptor against a real relational provider (InMemory never calls DbCommandInterceptor) -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.23" />

    <!-- samples/SampleApi.Controllers -->
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.4" />

    <!-- samples/* (Runner tab of the dashboard reads each sample's own OpenAPI document) -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="9.0.21" />

    <!-- NetApiFlow.MediatR -->
    <PackageVersion Include="MediatR" Version="12.5.0" />

    <!-- NetApiFlow.OpenTelemetry -->
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.21.0" />

    <!-- tests/NetApiFlow.OpenTelemetry.Tests: captures real Activity without a real OTLP collector -->
    <PackageVersion Include="OpenTelemetry.Exporter.InMemory" Version="1.21.0" />

    <!-- NetApiFlow.Mcp -->
    <PackageVersion Include="ModelContextProtocol.AspNetCore" Version="2.4.0" />

    <!-- tests/NetApiFlow.Mcp.Tests: real MCP client against the HTTP transport -->
    <PackageVersion Include="ModelContextProtocol" Version="2.4.0" />

    <!-- NetApiFlow.Storage.PostgreSql -->
    <PackageVersion Include="Npgsql" Version="8.0.9" />

    <!-- NetApiFlow.Storage.SqlServer -->
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="5.2.3" Condition="'$(MSBuildProjectName)' != 'NetApiFlow.SqlClient.IntegrationTests'" />
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="6.1.8" Condition="'$(MSBuildProjectName)' == 'NetApiFlow.SqlClient.IntegrationTests'" />

    <!-- Test-only: the SqlClient interop test needs a real SQL Server provider for its dedup case. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.23" />


    <!-- SourceLink (every src/ package) -->
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.404" />

    <!-- tests/NetApiFlow.Benchmarks (Fase 7, medição de overhead) -->
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.0" />
  </ItemGroup>

</Project>
