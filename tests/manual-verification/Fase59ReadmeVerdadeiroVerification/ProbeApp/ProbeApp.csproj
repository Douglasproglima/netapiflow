<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageVersion>0.0.0</PackageVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NetApiFlow" Version="[0.6.0-verify.1]" />
    <PackageReference Include="NetApiFlow.Dashboard" Version="[0.6.0-verify.1]" />
    <PackageReference Include="NetApiFlow.Mcp" Version="[0.6.0-verify.1]" />
    <PackageReference Include="NetApiFlow.OpenTelemetry" Version="[0.6.0-verify.1]" />
  </ItemGroup>

  <PropertyGroup Condition="'$(InstrumentationVersion)' != ''">
    <DefineConstants>$(DefineConstants);PROBE_INSTRUMENTATION</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(InstrumentationVersion)' != ''">
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="$(InstrumentationVersion)" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.*" />
  </ItemGroup>

</Project>
