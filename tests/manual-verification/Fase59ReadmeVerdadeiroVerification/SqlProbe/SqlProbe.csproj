<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NetApiFlow" Version="[0.6.0-verify.1]" />
    <PackageReference Include="NetApiFlow.Dashboard" Version="[0.6.0-verify.1]" />
    <PackageReference Include="NetApiFlow.Storage.SqlServer" Version="[0.6.0-verify.1]" />
  </ItemGroup>

  <ItemGroup Condition="'$(SqlClientVersion)' != ''">
    <PackageReference Include="Microsoft.Data.SqlClient" Version="$(SqlClientVersion)" />
  </ItemGroup>

</Project>
