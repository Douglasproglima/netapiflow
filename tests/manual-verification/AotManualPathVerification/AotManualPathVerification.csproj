<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PublishAot>true</PublishAot>
  </PropertyGroup>

  <ItemGroup>
    <!-- Same choice as the sibling annotation check: the trimming and AOT analyzers read the IL,
         so a project and a .nupkg give the same answer, and this runs without packing a feed. -->
    <ProjectReference Include="..\..\..\src\NetApiFlow\NetApiFlow.csproj" />
    <ProjectReference Include="..\..\..\src\NetApiFlow.EntityFrameworkCore\NetApiFlow.EntityFrameworkCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.22" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.22" />
  </ItemGroup>

</Project>
