<?xml version="1.0" encoding="utf-8"?>
<!--
  Overrides the parent folder's nuget.config, which points at local-nuget-feed/ and only restores
  after a `dotnet pack`. This project consumes NetApiFlow through a ProjectReference, so it has no
  reason to wait on a packed feed.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
