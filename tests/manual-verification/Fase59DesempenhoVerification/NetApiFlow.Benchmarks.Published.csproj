<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>NetApiFlow.Benchmarks</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="8.0.34" Condition="'$(TargetFramework)' == 'net8.0'" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.0" Condition="'$(TargetFramework)' == 'net10.0'" />
    <PackageReference Include="NetApiFlow" Version="0.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NetApiFlow.NetApiFlow" Alias="Flow" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\NetApiFlow.Benchmarks\Program.cs" Link="Program.cs" />
    <Compile Include="..\..\NetApiFlow.Benchmarks\BenchmarkHost.cs" Link="BenchmarkHost.cs" />
    <Compile Include="..\..\NetApiFlow.Benchmarks\StepOverheadBenchmarksBase.cs" Link="StepOverheadBenchmarksBase.cs" />
    <Compile Include="..\..\NetApiFlow.Benchmarks\StepEnabledBenchmarks.cs" Link="StepEnabledBenchmarks.cs" />
    <Compile Include="..\..\NetApiFlow.Benchmarks\StepDisabledBenchmarks.cs" Link="StepDisabledBenchmarks.cs" />
  </ItemGroup>

</Project>
