<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PublishAot>true</PublishAot>
  </PropertyGroup>

  <ItemGroup>
    <!-- ProjectReference, like its siblings: the analyzers read the IL, so a project and a
         .nupkg give the same answer, and this runs without packing a feed first. -->
    <ProjectReference Include="..\..\..\src\NetApiFlow\NetApiFlow.csproj" />
  </ItemGroup>

</Project>
