<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
    <!-- Re-packing a .nupkg without bumping its version leaves the machine-wide package folder
         holding the previous content for that same id and version, so a restore here would keep
         verifying the build before the change. These projects exist to check freshly packed
         output, so they extract into a folder of their own. -->
    <add key="globalPackagesFolder" value="./local-packages" />
  </config>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="netapiflow-local" value="./local-nuget-feed" />
  </packageSources>
</configuration>
